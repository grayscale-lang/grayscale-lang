---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { entries, headings } from '../lib/changelog';
---

<StarlightPage frontmatter={{ title: 'Changelog', pagefind: true }} headings={headings}>
  <p>See the full history of Grayscale.</p>
  {entries.map((entry) => (
    <section id={entry.id} class="changelog-entry">
      <h2>
        {entry.tag ? <a href={`https://github.com/${entry.repo}/releases/tag/${entry.tag}`}>{entry.title}</a> : entry.title}
        {entry.date && <time datetime={entry.date}>{entry.date}</time>}
      </h2>
      <Fragment set:html={entry.html} />
    </section>
  ))}
</StarlightPage>

<style>
  .changelog-entry {
    scroll-margin-top: calc(var(--sl-nav-height, 3.5rem) + 1rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .changelog-entry h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .changelog-entry h2 a {
    color: inherit;
    text-decoration: none;
  }

  .changelog-entry time {
    font-size: var(--sl-text-sm);
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
</style>
