---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CodeBlock from '../components/CodeBlock.astro';

const heroCode = `#flags
const Permissions enum {
    READ
    WRITE
    EXECUTE
}

const User struct {
    name string
    perms i64

    do can(self User, flag i64) -> bool {
        return (self.perms bit_and flag) != 0
    }
}

do main() {
    mut admin = User {
        name: "admin",
        perms: Permissions.READ bit_or Permissions.WRITE
    }

    if admin.can(Permissions.WRITE) {
        println("\${admin.name} has write access")
    }
}`;
---

<StarlightPage
  frontmatter={{ title: 'Grayscale', template: 'splash', hero: { tagline: '' }, pagefind: false }}
  headings={[]}
>
  <div class="landing">
    <section class="hero">
      <img src={`${import.meta.env.BASE_URL}/logo.png`} alt="Grayscale" class="hero-logo" />
      <h1>Grayscale</h1>
      <p class="tagline">Simple to write. Safe to run.</p>
      <div class="hero-actions">
        <a href={`${import.meta.env.BASE_URL}/overview/`} class="button primary">Get Started</a>
        <a href={`${import.meta.env.BASE_URL}/downloads/`} class="button secondary">Download</a>
      </div>
      <div class="version-badge" id="version-badge"></div>
    </section>

    <section class="code-example">
      <CodeBlock code={heroCode} />
    </section>

    <section class="features">
      <div class="feature-grid">
        <div class="feature-card">
          <h3>Simplicity</h3>
          <p>A minimal set of orthogonal features. Clean syntax with <code>do</code>, <code>mut</code>, <code>const</code>, and natural control flow keywords.</p>
        </div>
        <div class="feature-card">
          <h3>Clarity</h3>
          <p>Explicit syntax that reads naturally. String interpolation, multiple return values, and pattern matching with <code>when/is</code>.</p>
        </div>
        <div class="feature-card">
          <h3>Safety</h3>
          <p>Static type checking and runtime bounds checking. Overflow detection and first-class error handling built in.</p>
        </div>
      </div>
    </section>
  </div>
</StarlightPage>

<script>
  async function loadVersion() {
    try {
      const res = await fetch('https://api.github.com/repos/grayscale-lang/grayscale/releases/latest');
      if (!res.ok) return;
      const data = await res.json();
      const badge = document.getElementById('version-badge');
      if (badge && data.tag_name) {
        badge.textContent = data.tag_name;
        badge.style.display = 'inline-block';
      }
    } catch { /* silent */ }
  }
  loadVersion();
</script>

<style>
  :global([data-page-title]) {
    display: none;
  }

  .landing {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .hero {
    text-align: center;
    padding: 4rem 0 3rem;
  }

  .hero-logo {
    display: block;
    margin: 0 auto 1.5rem;
    width: 180px;
    height: 180px;
  }

  .hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--sl-color-gray-2);
    margin: 1rem 0 2rem;
    max-width: 36rem;
    margin-inline: auto;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    font-size: 1rem;
    transition: opacity 0.15s;
  }

  .button:hover {
    opacity: 0.85;
  }

  .button.primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-gray-6);
  }

  .button.secondary {
    border: 2px solid var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .version-badge {
    display: none;
    margin-top: 1.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-family: var(--sl-font-mono);
    border: 1px solid var(--sl-color-gray-4);
    color: var(--sl-color-gray-2);
  }

  .code-example {
    margin: 2rem 0 3rem;
  }

  .features {
    padding: 2rem 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .feature-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .feature-card p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .feature-card code {
    background: var(--sl-color-gray-5);
    padding: 0.1em 0.3em;
    border-radius: 0.25em;
    font-size: 0.85em;
  }

  @media (max-width: 40rem) {
    .hero h1 { font-size: 2.5rem; }
    .tagline { font-size: 1.1rem; }
  }
</style>
