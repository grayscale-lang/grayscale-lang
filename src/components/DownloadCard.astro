---
import { Icon } from '@astrojs/starlight/components';

interface Props {
  platform: string;
  arch: string;
  asset: string;
  icon: 'apple' | 'linux';
}

const { platform, arch, asset, icon } = Astro.props;
const baseUrl = 'https://github.com/grayscale-lang/grayscale/releases/latest/download';
const downloadUrl = `${baseUrl}/${asset}`;
---

<a href={downloadUrl} class="download-card">
  <span class="download-icon"><Icon name={icon} size="1.75rem" /></span>
  <div class="download-info">
    <strong>{platform}</strong>
    <span class="download-arch">{arch}</span>
  </div>
  <span class="download-arrow">&darr;</span>
</a>

<style>
  .download-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    text-decoration: none;
    color: var(--sl-color-white);
    transition: border-color 0.15s;
  }

  .download-card:hover {
    border-color: var(--sl-color-accent);
  }

  .download-icon {
    font-size: 1.5rem;
  }

  .download-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .download-arch {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }

  .download-arrow {
    font-size: 1.25rem;
    color: var(--sl-color-gray-3);
  }
</style>
