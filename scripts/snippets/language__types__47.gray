const Point struct {
    x i64
    y i64
}

alias Meters = f64
alias Vec2 = Point
alias Names = [string]
alias Lookup = map[string:i64]

do main() {
    mut distance Meters = 10.5
    mut origin Vec2 = Point{x: 1, y: 2}
    mut names Names = {"a", "b"}
    mut lookup Lookup = {"a": 1}
    println("${distance} ${origin.x} ${len(names)} ${len(lookup)}")
}
