const Point struct {
    x i64
    y i64
}

const Person struct {
    name string
    age i64
    active bool
}

do main() {
    mut origin Point = Point{x: 0, y: 0}
    mut person Person = Person{name: "Alice", age: 30, active: true}
    println("${origin.x}, ${origin.y}: ${person.name} is ${person.age}")
}
