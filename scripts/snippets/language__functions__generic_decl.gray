const Point struct {
    x i64
    y i64
}

do identity(T generic, x T) -> T {
    return x
}

do make(T generic) -> ^T {
    return new(T)
}

do first(T generic, arr [T]) -> (result T) {
    mut result T = arr[0]
    return result
}

do pair(a_kind generic, b_kind generic, a a_kind, b b_kind) -> (a_kind, b_kind) {
    return a, b
}

do main() {
    mut n = identity(i64, 42)        // T is i64, returns i64
    mut s = identity(string, "hi")   // T is string, returns string
    mut p = make(Point)              // allocates a Point, returns ^Point
    mut q = make(T: Point)        // named arguments work as for any parameter
    println(n)
    println(s)
    println(p^)
    println(q^)
    println(first(i64, {7, 8}))
    mut a, b = pair(i64, string, 1, "x")
    println(a)
    println(b)
}
