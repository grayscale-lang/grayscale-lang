import @mem

do read_fresh() -> i64 {
    unsafe {
        mut arena = mem.arena(4096)
        mut slot = mem.init(arena, i64)
        slot^ = 42
        mut result i64 = slot^
        mem.destroy(arena)
        return result
    }
}

private unsafe do bump(counter ^i64) {
    mut shared = raw(counter^)
    shared^ += 1
}

do main() {
    println(read_fresh())
    mut count i64 = 1
    unsafe {
        bump(addr(count))
    }
    println(count)
}
