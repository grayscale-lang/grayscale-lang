do main() {
    mut width i64 = 3
    mut height i64 = 3
    mut target i64 = 5
    mut grid [[i64]] = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}}
    mut found bool = false
    outer: for y in range(0, height) {
        for x in range(0, width) {
            if grid[y][x] == target {
                found = true
                break outer
            }
        }
    }
    println(found)
}
